SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key
ADMIN_JWT_SECRET=replace-with-a-long-random-admin-secret
USER_JWT_SECRET=replace-with-a-long-random-user-secret
CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain.com

# Gmail SMTP Configuration (required for email notifications)
# Generate App Password at: https://myaccount.google.com/apppasswords
SMTP_EMAIL=your-gmail@gmail.com
SMTP_PASSWORD=your-gmail-app-password
# Razorpay Payment Gateway Configuration (Test & Live Mode)
# Create keys in: Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
# Configure in: Razorpay Dashboard → Settings → Webhooks
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
